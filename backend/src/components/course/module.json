{
  "collectionName": "components_course_modules",
  "info": {
    "displayName": "Module"
  },
  "options": {},
  "attributes": {
    "module_id": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "language": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "English",
        "Hindi",
        "Gujarati"
      ]
    },
    "module_type": {
      "type": "enumeration",
      "required": true,
      "default": "Online",
      "enum": [
        "Online",
        "Offline"
      ]
    },
    "content_is_offline": {
      "type": "boolean",
      "required": true,
      "default": false,
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "module_type"
            },
            "Online"
          ]
        }
      }
    },
    "title": {
      "type": "string",
      "maxLength": 100,
      "required": true
    },
    "module_content_type": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "Video",
        "Pdf",
        "Text"
      ],
      "conditions": {
        "visible": {
          "and": [
            {
              "==": [
                {
                  "var": "module_type"
                },
                "Online"
              ]
            },
            {
              "!": [
                {
                  "var": "content_is_offline"
                }
              ]
            }
          ]
        }
      }
    },
    "video_file": {
      "type": "media",
      "conditions": {
        "visible": {
          "and": [
            {
              "==": [
                {
                  "var": "module_content_type"
                },
                "Video"
              ]
            },
            {
              "!": [
                {
                  "var": "content_is_offline"
                }
              ]
            }
          ]
        }
      },
      "multiple": true,
      "required": true,
      "allowedTypes": [
        "videos"
      ]
    },
    "pdf_file": {
      "type": "media",
      "conditions": {
        "visible": {
          "and": [
            {
              "==": [
                {
                  "var": "module_content_type"
                },
                "Pdf"
              ]
            },
            {
              "!": [
                {
                  "var": "content_is_offline"
                }
              ]
            }
          ]
        }
      },
      "multiple": true,
      "required": true,
      "allowedTypes": [
        "files"
      ]
    },
    "mark_as_read": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "module_duration_min": {
      "type": "customField",
      "customField": "global::number-range",
      "options": {
        "required": true,
        "positiveOnly": true
      }
    },
    "text_content": {
      "type": "customField",
      "conditions": {
        "visible": {
          "and": [
            {
              "==": [
                {
                  "var": "module_content_type"
                },
                "Text"
              ]
            },
            {
              "!": [
                {
                  "var": "content_is_offline"
                }
              ]
            }
          ]
        }
      },
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      },
      "required": true
    },
    "video_description": {
      "type": "customField",
      "conditions": {
        "visible": {
          "and": [
            {
              "==": [
                {
                  "var": "module_content_type"
                },
                "Video"
              ]
            },
            {
              "!": [
                {
                  "var": "content_is_offline"
                }
              ]
            }
          ]
        }
      },
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "quiz": {
      "type": "component",
      "component": "quiz.quiz",
      "repeatable": false,
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "module_type"
            },
            "Online"
          ]
        }
      }
    }
  },
  "config": {}
}
