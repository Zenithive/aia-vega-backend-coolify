{
  "collectionName": "components_quiz_answers",
  "info": {
    "displayName": "Answer"
  },
  "options": {},
  "attributes": {
    "question_id": {
      "type": "string",
      "required": true
    },
    "question": {
      "type": "string",
      "maxLength": 255,
      "required": true
    },
    "question_type": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "Multiple_choice",
        "Multiple_select",
        "Descriptive"
      ]
    },
    "selected_answer_for_multiChoice": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "question_type"
            },
            "Multiple_choice"
          ]
        }
      }
    },
    "point": {
      "type": "integer"
    },
    "correct": {
      "type": "boolean"
    },
    "selected_answer_for_multiSelect": {
      "type": "json",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "question_type"
            },
            "Multiple_select"
          ]
        }
      }
    },
    "user_answer_for_descriptive_question": {
      "type": "text",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "question_type"
            },
            "Descriptive"
          ]
        }
      },
      "maxLength": 1300
    }
  },
  "config": {}
}
