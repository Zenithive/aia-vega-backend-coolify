{
  "kind": "collectionType",
  "collectionName": "quiz_submissions",
  "info": {
    "singularName": "quiz-submission",
    "pluralName": "quiz-submissions",
    "displayName": "Quiz Submissions"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "answers": {
      "type": "component",
      "component": "quiz.answer",
      "repeatable": true,
      "required": true
    },
    "score": {
      "type": "integer",
      "required": true
    },
    "passed": {
      "type": "boolean",
      "required": true
    },
    "time_taken_minutes": {
      "type": "integer"
    },
    "attempt_number": {
      "type": "integer",
      "required": true
    },
    "submitted_by": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "submitted_at": {
      "type": "datetime",
      "required": true
    },
    "course": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course.course"
    },
    "user_progress": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::user-progress.user-progress",
      "inversedBy": "quiz_submission"
    },
    "submission_type": {
      "type": "enumeration",
      "enum": [
        "Auto Submit or Leave",
        "Time Limit Exceed",
        "Manual Submit"
      ]
    },
    "course_version": {
      "type": "string",
      "required": true
    },
    "module_id": {
      "type": "string"
    },
    "module_title": {
      "type": "string"
    },
    "review_status": {
      "type": "enumeration",
      "enum": [
        "Not_required",
        "Pending_review",
        "Reviewed"
      ],
      "default": "Not_required",
      "description": "Pending_review: descriptive answers await admin marking; score/passed are final only once Reviewed."
    },
    "reviewed_at": {
      "type": "datetime"
    },
    "reviewed_by": {
      "type": "string"
    }
  }
}
